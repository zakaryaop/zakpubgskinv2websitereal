# ── Database (Railway provides this automatically when you add PostgreSQL plugin)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=production
SERVE_STATIC=1
PORT=8080
APP_BASE_URL=https://your-app.railway.app
WEBHOOK_BASE_URL=https://your-app.railway.app

# ── Admin Login ────────────────────────────────────────────────────────────────
ADMIN_USERNAME=zak
ADMIN_PASSWORD=YourStrongPassword123!

# ── NOWPayments (Crypto: USDT, BTC, BNB, TRX, LTC) ───────────────────────────
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret

# ── SafePay (JazzCash, Easypaisa, Cards) ──────────────────────────────────────
SAFEPAY_API_KEY=your_safepay_api_key
SAFEPAY_SECRET=your_safepay_secret
SAFEPAY_ENV=production
USD_TO_PKR_RATE=280

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Resend Email ───────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=noreply@yourdomain.com

# ── Telegram Bot (optional) ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
VIPBOT_TOKEN=your_vipbot_token
VIPBOT_ADMIN_CHAT_ID=your_vipbot_admin_chat_id
VIP_GROUP_ID=your_vip_group_id

# ── Object Storage (optional) ─────────────────────────────────────────────────
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your_bucket_id
PRIVATE_OBJECT_DIR=private
PUBLIC_OBJECT_SEARCH_PATHS=public

# ── Misc ───────────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string
LOG_LEVEL=info
